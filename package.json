{
	"name": "pi-sakura-cyberdeck",
	"version": "3.1.0",
	"description": "A Sakura Macaron visual pack for Pi, built on Zentui v0.30.0, with a focused Oh My Pi skin.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/MaShouo/pi-zentui"
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-theme",
		"omp-plugin",
		"starship",
		"sakura",
		"tui"
	],
	"files": [
		"extensions",
		"themes",
		"licenses",
		"scripts",
		"NOTICE",
		"README.md",
		"LICENSE",
		"omp.ts",
		"docs/configuration.md",
		"docs/footer-format.md"
	],
	"scripts": {
		"check": "node scripts/check.mjs",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --testTimeout=30000",
		"test:behavior-compatibility": "node test/behavior-compatibility.mjs",
		"test:thinking-experimental-tui": "node test/thinking-experimental-tui.mjs",
		"test:thinking-experimental-diagnostics": "node test/thinking-experimental-loader-diagnostics.mjs",
		"pi:dev": "${PI_BIN:-/opt/homebrew/bin/pi} --no-extensions -e ./",
		"pi:install-local": "${PI_BIN:-/opt/homebrew/bin/pi} install ./ -l",
		"omp:dev": "${OMP_BIN:-omp} --no-extensions -e ./omp.ts",
		"omp:install-local": "${OMP_BIN:-omp} plugin link ./",
		"fmt": "biome format --write .",
		"fmt:check": "biome format .",
		"verify": "npm run check && npm run lint && npm run typecheck && npm run test",
		"pack:check": "node test/package-contents.mjs",
		"prepublishOnly": "npm run verify && npm run pack:check"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=0.85.0",
		"@earendil-works/pi-coding-agent": ">=0.85.0",
		"@earendil-works/pi-tui": ">=0.85.0",
		"@oh-my-pi/pi-ai": ">=18.4.10",
		"@oh-my-pi/pi-coding-agent": ">=18.4.10",
		"@oh-my-pi/pi-tui": ">=18.4.10"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"@oh-my-pi/pi-ai": {
			"optional": true
		},
		"@oh-my-pi/pi-coding-agent": {
			"optional": true
		},
		"@oh-my-pi/pi-tui": {
			"optional": true
		}
	},
	"omp": {
		"extensions": [
			"./omp.ts"
		]
	},
	"pi": {
		"extensions": [
			"./extensions/header/index.ts",
			"./extensions/matrix/index.ts",
			"./extensions/zentui/index.ts",
			"./extensions/claude-shimmer/index.ts"
		],
		"themes": [
			"./themes/sakura-macaron.json"
		]
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@earendil-works/pi-ai": "^0.87.1",
		"@earendil-works/pi-coding-agent": "^0.87.1",
		"@earendil-works/pi-tui": "^0.87.1",
		"@oh-my-pi/pi-ai": "18.4.10",
		"@oh-my-pi/pi-coding-agent": "18.4.10",
		"@oh-my-pi/pi-tui": "18.4.10",
		"@types/node": "^26.6.2",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	}
}
